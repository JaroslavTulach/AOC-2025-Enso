from Standard.Base import all
from Standard.Table import all
from Standard.Database import all
import Standard.Visualization
from Standard.Base.Meta import Enso_Project

main =
    file1 = Enso_Project.enso_project.data/"input.txt"
    data = Data.read file1 ..Delimited
    any1 = data.parse ['Column 1', 'Column 2'] type=..Integer
    result1 = any1.compute ..Sum
    any2 = any1.rename_columns [(Pair.Value 'Column 1' 'x'), (Pair.Value 'Column 2' 'y')]
    any3 = any2.cross_join any2
    any4 = any3.set (expr 'abs([x]-[Right x])+1') as="dx"
    any5 = any4.set (expr 'abs([y]-[Right y])+1') "dy"
    any6 = any5.set (expr '[dx]*[dy]') "sq"
    any7 = any6.sort [(..Name 'sq' ..Descending)]
    Runtime.assert (result1 == 13) "Expecting this result"


